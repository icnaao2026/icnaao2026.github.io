# LaTeX auxiliary files and build output
/aux/
/out/

# Letter sources and logos are tracked; generated files stay local.
/letters/**/aux/
/letters/**/out/
/letters/**/*.pdf
/letters/**/*.aux
/letters/**/*.log
/letters/**/*.out
/letters/**/*.fls
/letters/**/*.fdb_latexmk
/letters/**/*.synctex.gz
/letters/**/*.synctex(busy)
/letters/**/*.toc
/letters/**/*.lof
/letters/**/*.lot
/letters/**/*.bbl
/letters/**/*.blg
/letters/**/*.bcf
/letters/**/*.run.xml
/letters/**/*.xdv
/letters/**/*.dvi

# Keep the personal signature out of Git.
/letters/**/signature.*

# Registration spreadsheets (including reg.ods) contain personal information.
/reg.ods
/regis/**/*.ods
/regis/.~lock.*#

# All generated acceptance PDFs, email previews, and delivery logs.
/acceptance_letters/
/regis/__pycache__/

# Google OAuth credentials and local Python environment.
/regis/**/*credentials*.json
/regis/**/*token*.json
/regis/**/client_secret*.json
/regis/.venv/

# Generated speaker invitations, previews, and delivery history.
/speaker_invitations/out/
/speaker_invitations/__pycache__/
